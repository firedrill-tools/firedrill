{
  "name": "@firedrill-tools/simulation",
  "version": "0.1.0-rc.1",
  "description": "Versioned local simulation views and loopback control API for Firedrill",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "firedrill": {
    "layer": "adapter"
  },
  "scripts": {
    "build": "tsx ../../tooling/package-files.mts clean && tsc -p tsconfig.build.json && tsx ../../tooling/package-files.mts finalize",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@firedrill-tools/compiler": "workspace:*",
    "@firedrill-tools/contracts": "workspace:*",
    "@firedrill-tools/reporters": "workspace:*",
    "@firedrill-tools/sdk": "workspace:*",
    "@firedrill-tools/world-store": "workspace:*",
    "@firedrill-tools/world-store-sqlite": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrill-tools/firedrill.git",
    "directory": "packages/simulation"
  },
  "homepage": "https://firedrill.run",
  "bugs": {
    "url": "https://github.com/firedrill-tools/firedrill/issues"
  }
}
