{
  "name": "@firedrill/world-store",
  "version": "0.0.0",
  "description": "Storage port for a durable Firedrill world",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "firedrill": {
    "layer": "core"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp ../../LICENSE dist/LICENSE && cp ../../NOTICE dist/NOTICE",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@firedrill/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
