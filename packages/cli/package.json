{
  "name": "@firedrill/cli",
  "version": "0.1.0-rc.1",
  "description": "Local command-line interface for the Firedrill framework",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "firedrill": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tool-discovery": {
      "types": "./dist/tool-discovery.d.ts",
      "import": "./dist/tool-discovery.js"
    },
    "./schema/tool-index.json": "./dist/registry/tool-index.schema.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "firedrill": {
    "layer": "app",
    "dynamicImports": [
      "src/cloud-command.ts"
    ]
  },
  "scripts": {
    "build": "tsx ../../tooling/package-files.mts clean && tsc -p tsconfig.build.json && tsx scripts/copy-assets.mts && tsx ../../tooling/package-files.mts finalize --bin dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@firedrill/compiler": "workspace:*",
    "@firedrill/contracts": "workspace:*",
    "@firedrill/inspector": "workspace:*",
    "@firedrill/protocol-cli": "workspace:*",
    "@firedrill/sdk": "workspace:*",
    "@firedrill/world-build": "workspace:*",
    "tar": "7.5.22",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@firedrill/browser-tests": "workspace:*",
    "@firedrill/agent": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@firedrill/browser-tests": {
      "optional": true
    },
    "@firedrill/agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@firedrill/browser-tests": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@firedrill/agent": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrill-tools/firedrill.git",
    "directory": "packages/cli"
  },
  "homepage": "https://firedrill.tools",
  "bugs": {
    "url": "https://github.com/firedrill-tools/firedrill/issues"
  }
}
