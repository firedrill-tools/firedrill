{
  "name": "@firedrill/world-store-sqlite",
  "version": "0.1.0-rc.1",
  "description": "One-file SQLite world store for Firedrill",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "firedrill": {
    "layer": "core"
  },
  "scripts": {
    "build": "tsx ../../tooling/package-files.mts clean && tsc -p tsconfig.build.json && tsx ../../tooling/package-files.mts finalize",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@firedrill/contracts": "workspace:*",
    "@firedrill/world-store": "workspace:*",
    "better-sqlite3": "12.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrill-tools/firedrill.git",
    "directory": "packages/world-store-sqlite"
  },
  "homepage": "https://firedrill.tools",
  "bugs": {
    "url": "https://github.com/firedrill-tools/firedrill/issues"
  }
}
