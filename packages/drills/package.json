{
  "name": "@firedrill-run/drills",
  "version": "0.1.0-rc.1",
  "description": "Local drill lifecycle and target orchestration for Firedrill",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "firedrill": {
    "layer": "adapter",
    "dynamicImports": [
      "src/targets.ts"
    ]
  },
  "scripts": {
    "build": "tsx ../../tooling/package-files.mts clean && tsc -p tsconfig.build.json && tsx ../../tooling/package-files.mts finalize",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@firedrill-run/assertions": "workspace:*",
    "@firedrill-run/contracts": "workspace:*",
    "@firedrill-run/protocol-cli": "workspace:*",
    "@firedrill-run/protocol-http": "workspace:*",
    "@firedrill-run/protocol-mcp": "workspace:*",
    "@firedrill-run/world-build": "workspace:*",
    "@firedrill-run/world-ir": "workspace:*",
    "@firedrill-run/world-kernel": "workspace:*",
    "@firedrill-run/world-store": "workspace:*",
    "@firedrill-run/world-store-sqlite": "workspace:*",
    "tsx": "4.23.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@firedrill-run/tool-sdk": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrill-tools/firedrill.git",
    "directory": "packages/drills"
  },
  "homepage": "https://firedrill.run",
  "bugs": {
    "url": "https://github.com/firedrill-tools/firedrill/issues"
  }
}
