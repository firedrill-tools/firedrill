{
  "name": "@firedrill-run/compiler",
  "version": "0.1.0-rc.1",
  "description": "Deterministic repository compiler for local Firedrill worlds",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./dist/schema/*.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "firedrill": {
    "layer": "adapter"
  },
  "scripts": {
    "build": "tsx ../../tooling/package-files.mts clean && tsc -p tsconfig.build.json && tsx scripts/emit-schemas.mts && tsx ../../tooling/package-files.mts finalize",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@firedrill-run/contracts": "workspace:*",
    "@firedrill-run/tool-sdk": "workspace:*",
    "@firedrill-run/world-ir": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@firedrill-run/tool-sdk": "workspace:*",
    "@firedrill-run/world-build": "workspace:*",
    "@firedrill-run/world-kernel": "workspace:*",
    "@firedrill-run/world-store-sqlite": "workspace:*",
    "@types/semver": "7.8.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrill-tools/firedrill.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://firedrill.run",
  "bugs": {
    "url": "https://github.com/firedrill-tools/firedrill/issues"
  }
}
