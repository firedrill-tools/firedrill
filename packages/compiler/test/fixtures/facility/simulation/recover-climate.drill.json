{
  "schemaVersion": 1,
  "id": "recover-climate",
  "targetId": "facility-agent",
  "actorId": "operator",
  "scenarioId": "unresponsive-controller",
  "task": { "instruction": "Try to set a safe greenhouse temperature." },
  "assertions": [
