{
  "name": "@firedrill/tool-github-issues",
  "version": "0.1.0-rc.1",
  "description": "A bounded, stateful GitHub Issues-compatible Tool pack for Firedrill",
  "keywords": [
    "ai-agent",
    "firedrill",
    "github",
    "issues",
    "testing",
    "tool-pack"
  ],
  "maintainers": [
    {
      "name": "Firedrill contributors"
    }
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "github-issues.tool.yaml",
    "starter.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "firedrill": {
    "layer": "tool-pack",
    "tool": "github-issues.tool.yaml",
    "starter": "starter.json",
    "lifecycle": "active",
    "conformance": "github-issues-conformance"
  },
  "scripts": {
    "build": "tsx ../../tooling/package-files.mts clean && tsc -p tsconfig.build.json && tsx ../../tooling/package-files.mts finalize",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/pack.test.mjs"
  },
  "dependencies": {
    "@firedrill/tool-sdk": "workspace:*"
  },
  "devDependencies": {
    "@octokit/rest": "21.1.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrill-tools/firedrill.git",
    "directory": "tool-packs/github-issues"
  },
  "homepage": "https://firedrill.tools",
  "bugs": {
    "url": "https://github.com/firedrill-tools/firedrill/issues"
  }
}
