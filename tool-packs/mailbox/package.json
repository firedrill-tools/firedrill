{
  "name": "@firedrill-tools/tool-mailbox",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "Stateful synthetic mailbox Tool pack for Firedrill",
  "keywords": [
    "ai-agent",
    "firedrill",
    "testing",
    "tool-pack",
    "mailbox"
  ],
  "maintainers": [
    {
      "name": "Firedrill contributors"
    }
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "mailbox.tool.yaml",
    "starter.json",
    "firedrill.json",
    "conformance",
    "README.md"
  ],
  "firedrill": {
    "layer": "tool-pack",
    "tool": "mailbox.tool.yaml",
    "starter": "starter.json",
    "lifecycle": "active",
    "conformance": {
      "schemaVersion": 1,
      "project": "firedrill.json",
      "suite": "mailbox-conformance"
    }
  },
  "scripts": {
    "build": "tsx ../../tooling/package-files.mts clean && tsc -p tsconfig.build.json && tsx ../../tooling/build-tool-app.mts && tsx ../../tooling/package-files.mts finalize",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../packages/cli/dist/bin.js format --check --root . && node ../../packages/cli/dist/bin.js tool test mailbox --root . && node --test test/public-world.test.mjs"
  },
  "dependencies": {
    "@firedrill-run/tool-sdk": "workspace:*"
  },
  "devDependencies": {
    "@firedrill-run/sdk": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedrill-tools/firedrill.git",
    "directory": "tool-packs/mailbox"
  },
  "homepage": "https://firedrill.run",
  "bugs": {
    "url": "https://github.com/firedrill-tools/firedrill/issues"
  }
}
