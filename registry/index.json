        "capabilities": ["event.emit", "state.read", "state.write"],
        "state": ["messages"],
        "operations": [
          {
            "id": "messages.delete",
            "fidelity": "stateful"
          },
          {
            "id": "messages.get",
            "fidelity": "stateful"
          },
          {
            "id": "messages.list",
            "fidelity": "stateful"
          },
          {
            "id": "messages.send",
            "fidelity": "behavioral"
          },
          {
            "id": "messages.write",
            "fidelity": "stateful"
          }
        ],
        "http": [
          {
            "id": "delete",
            "operationId": "messages.delete",
            "method": "DELETE",
            "path": "/mailbox/messages/{id}"
          },
          {
            "id": "get",
            "operationId": "messages.get",
            "method": "GET",
            "path": "/mailbox/messages/{id}"
          },
          {
            "id": "list",
            "operationId": "messages.list",
            "method": "GET",
            "path": "/mailbox/messages"
          },
          {
            "id": "send",
            "operationId": "messages.send",
            "method": "POST",
            "path": "/mailbox/messages/{id}/send"
          },
          {
            "id": "write",
            "operationId": "messages.write",
            "method": "PUT",
            "path": "/mailbox/messages/{id}"
          }
        ],
        "compatibility": [],
        "events": ["message.sent"],
        "faults": [],
        "subscriptions": []
      }
    },
    {
