{
  "schemaVersion": 1,
  "node": ">=20.19",
  "pnpm": ">=9.15 <11",
  "packageManager": "pnpm@9.15.4",
  "cli": {
    "package": "@firedrill-run/cli",
    "binary": "firedrill",
    "entrypoint": "./dist/bin.js",
    "helpCommands": [
      [],
      ["mcp"],
      ["data"],
      ["data", "preview"],
      ["data", "save"],
      ["browser"],
      ["browser", "install"],
      ["browser", "run"],
      ["browser", "verify"],
      ["agent"],
      ["run"],
      ["validate"],
      ["plan"],
      ["build"],
      ["format"],
      ["compare"],
      ["report", "verify"],
      ["init"],
      ["inspect"],
      ["serve"],
      ["tool"],
      ["tool", "list"],
      ["tool", "search"],
      ["tool", "create"],
      ["tool", "add"],
      ["tool", "inspect"],
      ["tool", "validate"],
      ["tool", "test"],
      ["tool", "contribute"],
      ["world"]
    ]
  },
  "packages": [
    {
      "name": "@firedrill-run/agent",
      "directory": "packages/agent",
      "layer": "adapter",
      "exports": [".", "./browser"]
    },
    {
      "name": "@firedrill-run/browser-tests",
      "directory": "packages/browser-tests",
      "layer": "adapter",
      "exports": [".", "./contracts"]
    },
    {
      "name": "@firedrill-run/assertions",
      "directory": "packages/assertions",
      "layer": "core",
      "exports": ["."]
    },
    {
      "name": "@firedrill-run/cli",
      "directory": "packages/cli",
      "layer": "app",
      "exports": [".", "./schema/tool-index.json", "./tool-discovery"]
    },
    {
      "name": "@firedrill-run/compiler",
      "directory": "packages/compiler",
      "layer": "adapter",
      "exports": [".", "./schema/*"]
    },
    {
      "name": "@firedrill-run/contracts",
      "directory": "packages/contracts",
      "layer": "core",
      "exports": [".", "./schema/*", "./schemas"]
    },
    {
      "name": "@firedrill-run/drills",
      "directory": "packages/drills",
      "layer": "adapter",
      "exports": ["."]
    },
    {
      "name": "@firedrill-run/inspector",
      "directory": "packages/inspector",
      "layer": "adapter",
      "exports": ["."]
    },
    {
      "name": "@firedrill-run/protocol-cli",
      "directory": "packages/protocol-cli",
      "layer": "adapter",
      "exports": ["."]
    },
    {
      "name": "@firedrill-run/protocol-http",
      "directory": "packages/protocol-http",
      "layer": "adapter",
      "exports": ["."]
    },
    {
      "name": "@firedrill-run/protocol-mcp",
      "directory": "packages/protocol-mcp",
      "layer": "adapter",
      "exports": ["."]
    },
    {
      "name": "@firedrill-run/reporters",
      "directory": "packages/reporters",
      "layer": "adapter",
      "exports": ["."]
    },
    {
      "name": "@firedrill-run/sdk",
      "directory": "packages/sdk",
      "layer": "adapter",
      "exports": [".", "./testing"]
    },
    {
      "name": "@firedrill-run/simulation",
      "directory": "packages/simulation",
      "layer": "adapter",
      "exports": ["."]
    },
    {
      "name": "@firedrill-run/tool-sdk",
      "directory": "packages/tool-sdk",
      "layer": "core",
      "exports": [".", "./behavior-runtime", "./package.json"]
    },
    {
      "name": "@firedrill-run/world-build",
      "directory": "packages/world-build",
      "layer": "adapter",
      "exports": ["."]
    },
    {
      "name": "@firedrill-run/world-ir",
      "directory": "packages/world-ir",
      "layer": "core",
      "exports": [".", "./schema/*"]
    },
    {
      "name": "@firedrill-run/world-kernel",
      "directory": "packages/world-kernel",
      "layer": "core",
      "exports": ["."]
    },
    {
      "name": "@firedrill-run/world-store",
      "directory": "packages/world-store",
      "layer": "core",
      "exports": ["."]
    },
    {
      "name": "@firedrill-run/world-store-sqlite",
      "directory": "packages/world-store-sqlite",
      "layer": "core",
      "exports": ["."]
    }
  ]
}
